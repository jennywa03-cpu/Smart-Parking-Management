# Server
# Railway MySQL reference variables are also supported: MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
PORT=4000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=Park_db
DB_PORT=3306

# Security
JWT_SECRET=change_this_to_a_long_random_value
JWT_EXPIRES_IN=1d
PAYMENT_WEBHOOK_SECRET=change_this_payment_webhook_secret
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# Frontend / CORS
APP_NAME=Smart Parking Management
RESET_URL_BASE=http://localhost:5500/reset-password.html
CORS_ORIGIN=http://localhost:5500
CORS_ALLOW_ALL=false
SHOW_RESET_TOKEN=false

# Payment hold and expiry
BOOKING_HOLD_SECONDS=120
BOOKING_EXPIRY_SCAN_MS=30000

# Scheduled reports
REPORT_EXPORT_ENABLED=true
REPORT_EXPORT_TIME=02:00
REPORT_EXPORT_DIR=exports
REPORT_EXPORT_TYPES=occupancy,revenue,users

# M-Pesa Daraja (optional)
MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ACCOUNT_REFERENCE=ParkManagement
MPESA_TRANSACTION_DESC=Parking payment
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Email delivery
EMAIL_ENABLED=false
EMAIL_PROVIDER=brevo_both
MAIL_FROM=verified-sender@example.com
MAIL_FROM_NAME=Smart Parking Management
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your-smtp-login@smtp-brevo.com
BREVO_SMTP_KEY=
BREVO_SMTP_SECURE=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Smart Parking Management
BREVO_TEST_TO=

# SMS delivery (optional)
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

ADMIN_SEED_NAME=System Administrator
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FORCE_PASSWORD_CHANGE=true